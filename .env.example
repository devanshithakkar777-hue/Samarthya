# Copy to .env for local use only. Never commit .env. Real secrets go in the Render dashboard (see DEPLOY.md).

# ---- API (apps/api) ----
ENV=dev                      # dev | prod. prod enforces a strong JWT_SECRET and real email settings
# 32+ random characters:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# App connection. On Neon use the POOLED string (host contains "-pooler"). postgres:// and postgresql:// are both accepted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Neon only: the DIRECT (non-pooled) string, used for migrations. Leave empty for a local database.
DIRECT_DATABASE_URL=
DB_POOL_SIZE=5
DB_POOL_RECYCLE_SECONDS=300
LOG_LEVEL=INFO
RUN_MIGRATIONS=1             # 1 = run `alembic upgrade head` when the container starts
TRUSTED_PROXY_HOPS=0         # 0 locally; 1 on Render (see DEPLOY.md)
CORS_ORIGINS=http://localhost:3000   # the web app's public URL in production
# Encrypts private journal entries (Fernet key material). 32+ random characters, required in prod.
# BACK IT UP: if it is lost, journal entries cannot be recovered.
JOURNAL_KEY=
# Optional AI companion: OFF unless provider, key and model are all set. No default provider is assumed.
# LLM_PROVIDER is one of: anthropic, gemini, groq, openrouter
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_LIMIT=
# Email for sign-in codes (required when ENV=prod)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional: this address becomes admin when it signs in. Remove it after the first admin exists.
ADMIN_BOOTSTRAP_EMAIL=

# ---- Web (apps/web) ----
API_URL=http://localhost:8000        # the API's URL as seen from the web server
SITE_URL=http://localhost:3000       # the public URL of the site

# ---- docker-compose.yml only (self-hosted alternative) ----
POSTGRES_PASSWORD=
